---
import { url } from '../lib/url';
interface Props {
  href: string;
  title: string;
  summary: string;
  index: number;
}
const { href, title, summary, index } = Astro.props;
---
<a
  href={url(href)}
  class="group flex h-full flex-col rounded-card border border-sand bg-linen p-7 no-underline shadow-card transition-[transform,box-shadow] duration-300 ease-[var(--ease-calm)] motion-safe:hover:-translate-y-1 hover:shadow-card-hover sm:p-8"
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
>
  <span class="font-display text-sm text-terracotta">0{index + 1}</span>
  <h3 class="mt-3 text-h3 transition-colors group-hover:text-teal-deep">{title}</h3>
  <p class="mt-3 flex-1 text-ink-soft leading-relaxed">{summary}</p>
  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-teal">
    Learn more
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>
