---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';
import Placeholder from './Placeholder.astro';
interface Props { href: string; title: string; summary?: string; summaryTodo?: string; tree: ImageMetadata; treeAlt: string; index: number }
const { href, title, summary, summaryTodo, tree, treeAlt, index } = Astro.props;
---
<a
  href={url(href)}
  class="group flex h-full flex-col items-center rounded-card border border-sand bg-white/70 p-7 text-center no-underline shadow-card transition-[transform,box-shadow] duration-300 ease-[var(--ease-calm)] motion-safe:hover:-translate-y-1 hover:shadow-card-hover sm:p-8"
  data-reveal
  style={`--reveal-delay:${index * 90}ms`}
>
  <Image src={tree} alt={treeAlt} width={360} densities={[1, 2]} format="webp" class="h-40 w-auto max-w-[11rem] object-contain transition-transform duration-500 ease-[var(--ease-calm)] motion-safe:group-hover:scale-[1.04]" loading="lazy" />
  <h3 class="mt-6 text-h3 transition-colors group-hover:text-teal">{title}</h3>
  {summary ? (
    <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{summary}</p>
  ) : (
    <div class="mt-3 flex-1"><Placeholder text={summaryTodo ?? 'card blurb'} /></div>
  )}
  <span class="mt-6 inline-flex h-10 w-10 items-center justify-center rounded-pill border border-teal/30 text-teal-deep transition-colors group-hover:bg-teal group-hover:text-cream" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>
