---
/**
 * A correctly sized placeholder image with real alt text and a visible note
 * describing the real image that should replace it.
 */
import { url } from '../lib/url';
import Placeholder from './Placeholder.astro';
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  todo?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, width, height, todo, class: extra = '', eager = false } = Astro.props;
---
<figure class:list={['space-y-3', extra]}>
  <img
    src={url(src)}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="h-auto w-full rounded-image object-cover shadow-card"
  />
  {todo && <figcaption><Placeholder text={todo} /></figcaption>}
</figure>
