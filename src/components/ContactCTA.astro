---
/**
 * "Connect With Me" block, as on Emree's pages: her heading, Email and Phone.
 * The hand-and-seedling photo from her site sits behind it, softened.
 */
import { Image } from 'astro:assets';
import site from '../content/site.json';
import { original } from '../lib/assets';
import Divider from './Divider.astro';
interface Props { as?: 'h1' | 'h2'; showTelehealth?: boolean }
const { as: Tag = 'h2', showTelehealth = false } = Astro.props;
const photo = original('photo-hand-seedling.jpg');
---
<section id="connect" class="relative isolate overflow-hidden bg-leaf-soft scroll-mt-24">
  <Divider color="text-cream" position="top" />
  <Image src={photo} alt="" widths={[640, 1280, 1920]} sizes="100vw" format="webp" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-60" loading="lazy" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-cream/95 via-cream/80 to-leaf-soft/55" aria-hidden="true"></div>
  <div class="container-site py-section">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_1.1fr]" data-reveal>
      <Tag class="text-h2">Connect With Me</Tag>
      <div class="grid gap-4">
        <p class="rounded-card bg-white/80 p-5 shadow-card">
          <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">Email:</span>
          <a href={`mailto:${site.email}`} class="mt-1 block font-display text-lg text-teal-deep underline-offset-4 hover:underline sm:text-xl [overflow-wrap:anywhere]">{site.email}</a>
        </p>
        <p class="rounded-card bg-white/80 p-5 shadow-card">
          <span class="block text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft">Phone:</span>
          <a href={site.phoneHref} class="mt-1 block font-display text-lg text-teal-deep underline-offset-4 hover:underline sm:text-xl">{site.phone}</a>
        </p>
        {showTelehealth && <p class="text-sm leading-relaxed text-ink-soft">{site.telehealthLine} {site.privacyLine}</p>}
      </div>
    </div>
  </div>
</section>
