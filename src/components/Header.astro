---
import { Image } from 'astro:assets';
import wordmark from '../assets/logo-wordmark-trimmed.png';
import site from '../content/site.json';
import { url, currentPath } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Me' },
  { href: '/services', label: 'Scope of Practice' },
  { href: '/licenses-payments', label: 'Licenses & Payments' },
];
const here = currentPath(Astro.url.pathname);
const isActive = (href: string) => (href.includes('#') ? false : href === '/' ? here === '/' : here === href || here.startsWith(`${href}/`));
---
<header class="sticky top-0 z-40 border-b border-sand bg-cream/95 shadow-[0_1px_0_rgb(39_48_47/0.04)] backdrop-blur-md">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-teal focus:px-4 focus:py-2 focus:text-cream">
    Skip to content
  </a>
  <div class="container-site flex items-center justify-between gap-6 py-4 lg:py-5">
    <a href={url('/')} class="block shrink-0 no-underline" aria-label={`${site.name} home`}>
      <Image src={wordmark} alt={`${site.name}. ${site.tagline}.`} width={420} densities={[1, 2, 3]} format="png" class="h-auto w-[15.5rem] sm:w-[20rem] lg:w-[25rem]" loading="eager" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li>
            <a
              href={url(l.href)}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'inline-block rounded-pill px-4 py-2 text-[0.95rem] font-medium text-ink transition-colors duration-200 hover:bg-leaf-soft hover:text-teal-deep',
                isActive(l.href) && 'bg-teal-soft text-teal-deep',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button type="button" class="lg:hidden inline-flex items-center gap-2 rounded-pill border border-sand-deep px-4 py-2 text-sm font-semibold text-teal-deep" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
      <span data-nav-label>Menu</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Primary mobile" class="lg:hidden hidden border-t border-sand bg-linen" data-nav-panel>
    <ul class="container-site flex flex-col py-3">
      {links.map((l) => (
        <li>
          <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined} class:list={['block rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-leaf-soft hover:text-teal-deep', isActive(l.href) && 'font-semibold text-teal-deep']}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) { setOpen(false); toggle.focus(); }
    });
  }
</script>
