---
interface Props { tone?: 'cream' | 'linen' | 'teal' | 'leaf'; size?: 'default' | 'sm'; id?: string; class?: string; texture?: boolean }
const { tone = 'cream', size = 'default', id, class: extra = '', texture = false } = Astro.props;
const tones = { cream: 'bg-cream', linen: 'bg-linen', leaf: 'bg-leaf-soft', teal: 'bg-teal surface-teal text-cream' };
---
<section id={id} class:list={['relative', tones[tone], size === 'sm' ? 'py-section-sm' : 'py-section', texture && 'texture-linen', extra]}>
  <div class="container-site relative"><slot /></div>
</section>
