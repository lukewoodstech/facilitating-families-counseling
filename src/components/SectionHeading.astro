---
interface Props {
  eyebrow?: string;
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, as: Tag = 'h2', align = 'left', class: extra = '' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', extra]} data-reveal>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Tag class:list={[Tag === 'h1' ? 'text-h1' : 'text-h2']}>{title}</Tag>
  <slot />
</div>
