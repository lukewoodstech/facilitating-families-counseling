---
import { getCollection } from 'astro:content';
import ServiceCard from './ServiceCard.astro';
import { original } from '../lib/assets';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {services.map((s, i) => (
    <ServiceCard href={`/services/${s.id}`} title={s.data.cardTitle} summary={s.data.summary} summaryTodo={s.data.summaryTodo} tree={original(s.data.tree)} treeAlt={s.data.treeAlt} index={i} />
  ))}
</div>
