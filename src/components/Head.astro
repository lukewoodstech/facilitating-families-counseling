---
/**
 * Per-page <head>: unique title + description, canonical URL, Open Graph / Twitter
 * cards, favicon, and the inline "js" class that enables the scroll reveal.
 */
import site from '../content/site.json';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute title override (used by the home page) */
  fullTitle?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description = site.defaultDescription, fullTitle, ogImage, noindex = false } = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage ?? url('/og-default.png'), Astro.site).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<meta name="theme-color" content="#f8f4ed" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<script is:inline>document.documentElement.classList.add('js');</script>
