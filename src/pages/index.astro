---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import Divider from '../components/Divider.astro';
import LeafAccent from '../components/LeafAccent.astro';
import mark from '../assets/logo-mark-transparent.png';
import site from '../content/site.json';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: CoreBelief } = await render(home);
const hero = home.data.hero!;
const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
---
<BaseLayout title="Home" fullTitle={`${site.name} | ${site.tagline}`} description={home.data.description}>
  <!-- HERO: her logo and tree mark carry it. No photo here by design. -->
  <section class="texture-linen relative overflow-hidden bg-cream">
    <LeafAccent class="-left-24 -bottom-24 w-[26rem] md:w-[36rem]" opacity="opacity-[0.06]" />
    <div class="container-site relative py-section md:py-[clamp(6rem,4rem+7vw,10rem)]">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
        <div class="max-w-2xl" data-reveal>
          <h1 class="text-display font-display text-teal-deep">{hero.headline}</h1>
          <div class="mt-10 flex flex-wrap gap-3">
            <Button href="/contact" size="lg">Connect With Me</Button>
            <Button href="/services" variant="secondary" size="lg">Scope of Practice</Button>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-md" data-reveal style="--reveal-delay:150ms">
          <div class="absolute inset-[10%] -z-10 rounded-full bg-leaf-soft blur-3xl" aria-hidden="true"></div>
          <Image src={mark} alt="The Facilitating Families Counseling tree: three figures growing together as one tree" width={720} densities={[1, 2]} format="webp" class="h-auto w-full" loading="eager" />
        </div>
      </div>
    </div>
    <Divider color="text-linen" position="bottom" />
  </section>

  <!-- ABOUT ME: her photo and a short about section (placeholders until Emree sends copy) -->
  <Section tone="linen" texture id="about">
    <div class="grid items-center gap-10 md:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div class="mx-auto w-full max-w-xs md:max-w-none" data-reveal>
        <PlaceholderImage src="/images/placeholders/about-headshot.svg" alt="Placeholder for a portrait of Emree" width={960} height={1200} todo="Headshot of Emree (portrait, 4:5 or square, at least 1200px on the short side)" />
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <h2 class="text-h2">{about.data.heading}</h2>
        <p class="mt-3 font-display text-lead italic text-ink-soft"><Placeholder inline text="Emree's full name and credentials" /></p>
        <div class="mt-6 space-y-3">
          <Placeholder text="Short about section in Emree's words: who she is, how long she has been practicing, and how she works with clients" />
        </div>
        <div class="mt-8"><Button href="/contact">Connect With Me</Button></div>
      </div>
    </div>
  </Section>

  <!-- CORE BELIEF: her heading, her words. Double wave band echoes her business card. -->
  <section id="core-belief" class="surface-teal relative bg-teal text-cream">
    <!-- leaf-green band with the teal wave rising through it, like the card -->
    <div class="relative h-[clamp(2.5rem,6vw,4.5rem)] bg-leaf-soft" aria-hidden="true">
      <Divider color="text-teal" position="bottom" flip />
    </div>
    <LeafAccent class="-right-20 top-10 w-[24rem] md:w-[34rem]" opacity="opacity-[0.08]" />
    <div class="container-site relative py-section">
      <div class="container-prose" data-reveal>
        <h2 class="mb-10 text-center text-h2">{home.data.heading}</h2>
        <div class="core-belief prose text-center"><CoreBelief /></div>
      </div>
    </div>
    <Divider color="text-cream" position="bottom" />
  </section>

  <!-- SCOPE OF PRACTICE: one card per service, each with her original tree illustration -->
  <Section tone="cream" id="scope-of-practice">
    <h2 class="mb-12 text-center text-h2" data-reveal>Scope of Practice</h2>
    <ServiceGrid />
  </Section>

  <ContactCTA />
</BaseLayout>
