---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import site from '../content/site.json';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: CoreBelief } = await render(home);
const hero = home.data.hero!;
---
<BaseLayout title="Home" fullTitle={`${site.name} | ${hero.headline}`} description={home.data.description}>
  <!-- HERO: abstract warm treatment, no photo of Emree here by design -->
  <section class="texture-linen relative overflow-hidden bg-linen">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -right-32 -top-40 h-[34rem] w-[34rem] rounded-full bg-teal-soft/70 blur-3xl"></div>
      <div class="absolute -bottom-48 -left-24 h-[30rem] w-[30rem] rounded-full bg-terracotta-soft/80 blur-3xl"></div>
      <svg class="absolute right-[-6rem] top-1/2 hidden w-[42rem] -translate-y-1/2 text-teal/[0.08] lg:block" viewBox="0 0 600 600" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="300" cy="300" r="280" /><circle cx="300" cy="300" r="210" /><circle cx="300" cy="300" r="140" /><circle cx="300" cy="300" r="70" />
      </svg>
    </div>
    <div class="container-site relative py-section md:py-[clamp(7rem,5rem+8vw,12rem)]">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow mb-6">Facilitating Families Counseling, LLC</p>
        <h1 class="text-display font-display text-teal">{hero.headline}</h1>
        {hero.subhead && <p class="mt-6 max-w-xl font-display text-lead italic text-ink-soft" style="font-variation-settings: 'SOFT' 100, 'WONK' 1;">{hero.subhead}</p>}
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/contact" size="lg">Connect with me</Button>
          <Button href="/services" variant="secondary" size="lg">Explore services</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- CORE BELIEF: the heart of the site -->
  <Section tone="teal" id="core-belief">
    <div class="container-prose" data-reveal>
      <p class="eyebrow mb-8 text-center">{home.data.eyebrow}</p>
      <div class="core-belief prose text-center">
        <CoreBelief />
      </div>
    </div>
  </Section>

  <!-- SERVICES -->
  <Section tone="cream" id="services">
    <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading eyebrow="Scope of Practice" title="How I can help" />
      <div data-reveal><Button href="/services" variant="ghost">All services &rarr;</Button></div>
    </div>
    <ServiceGrid />
  </Section>

  <!-- ABOUT TEASER -->
  <Section tone="linen" texture id="about">
    <div class="grid items-center gap-10 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div data-reveal>
        <PlaceholderImage
          src="/images/placeholders/about-headshot.svg"
          alt="Placeholder for a portrait of Emree"
          width={960}
          height={1200}
          class="max-w-sm md:max-w-none"
        />
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <p class="eyebrow mb-4">About Me</p>
        <h2 class="text-h2">{site.therapist} <Placeholder inline text="last name" /></h2>
        <blockquote class="mt-6 border-l-2 border-terracotta pl-5 font-display text-lead italic text-ink">
          I believe in being upfront, honest, and direct in identifying what is and is not working for you as an individual. We are a team.
        </blockquote>
        <div class="mt-6"><Placeholder text="Short About teaser (2 to 3 sentences from Emree's bio)" /></div>
        <div class="mt-8"><Button href="/about" variant="secondary">More about me</Button></div>
      </div>
    </div>
  </Section>

  <ContactCTA />
</BaseLayout>
