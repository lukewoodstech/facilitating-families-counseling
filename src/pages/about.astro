---
/**
 * About Me: her photo and her About text on top, then "My Dopamine Playlist"
 * (her favorite things as a sideways-scrolling row of small note cards), then
 * Connect With Me with email, phone and the telehealth line.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Placeholder from '../components/Placeholder.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Button from '../components/Button.astro';
import site from '../content/site.json';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const contact = await getEntry('pages', 'contact');
if (!contact) throw new Error('Missing src/content/pages/contact.md');
const d = page.data;
const { Content } = await render(page);
const playlist = d.playlist ?? [];
// Soft alternating fills and tilts so the cards read as notes, not tiles.
const noteTones = ['bg-white', 'bg-leaf-soft', 'bg-teal-soft', 'bg-linen'];
const noteTilts = ['-rotate-[1.2deg]', 'rotate-[0.8deg]', '-rotate-[0.6deg]', 'rotate-[1.4deg]'];
---
<BaseLayout title={d.title} description={d.description}>
  <PageHero title={d.heading ?? d.title}>
    <p class="mt-4 font-display text-h3 text-teal">{site.therapistFullName}, {site.credentials}</p>
    <p class="mt-1 font-body text-lead text-ink-soft">{site.credentialsLong}</p>
  </PageHero>

  <Section>
    <div class="grid items-start gap-10 md:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div class="mx-auto w-full max-w-xs md:sticky md:top-8 md:max-w-none" data-reveal>
        <PlaceholderImage src="/images/placeholders/about-headshot.svg" alt="Placeholder for a portrait of EmRee M. Pugmire" width={960} height={1200} todo="Headshot of EmRee (portrait, 4:5 or square, at least 1200px on the short side)" eager />
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <article class="prose max-w-none"><Content /></article>
        <div class="pt-8"><Button href="/about#connect">Connect With Me</Button></div>
      </div>
    </div>
  </Section>

  {playlist.length > 0 && (
    <Section tone="linen" texture>
      <h2 id="playlist" class="text-h2" data-reveal>{d.playlistTitle}</h2>
      <ul
        class="playlist mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-6 pt-3"
        aria-labelledby="playlist"
        tabindex="0"
      >
        {playlist.map((group, i) => (
          <li
            class:list={[
              'w-[15rem] shrink-0 snap-start rounded-card border border-sand p-5 shadow-card transition-transform duration-300 motion-safe:hover:rotate-0 motion-safe:hover:-translate-y-1',
              noteTones[i % noteTones.length],
              noteTilts[i % noteTilts.length],
            ]}
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <h3 class="font-display text-lg leading-snug text-teal-deep">{group.title}</h3>
            <ul class="mt-3 space-y-2 text-[0.975rem] leading-snug text-ink">
              {group.items.map((item) => (
                <li class="flex gap-2"><span aria-hidden="true" class="mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full bg-leaf"></span><span>{item}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <ContactCTA showTelehealth />

  {contact.data.todos.length > 0 && (
    <Section size="sm">
      <div class="max-w-xl space-y-3" data-reveal>
        {contact.data.todos.map((t) => <Placeholder text={t} />)}
      </div>
    </Section>
  )}
</BaseLayout>
