---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Placeholder from '../components/Placeholder.astro';
import ContactCTA from '../components/ContactCTA.astro';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing src/content/pages/contact.md');
const d = page.data;
---
<BaseLayout title={d.title} description={d.description}>
  <ContactCTA as="h1" showTelehealth />
  <Section size="sm">
    <div class="max-w-xl" data-reveal>
      {d.todos.map((t) => <Placeholder text={t} />)}
    </div>
  </Section>
</BaseLayout>
